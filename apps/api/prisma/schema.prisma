generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String               @id @default(cuid())
  clerkUserId              String?              @unique @map("clerk_user_id")
  name                     String?
  email                    String?
  phone                    String?
  status                   UserStatus           @default(ACTIVE)
  createdAt                DateTime             @default(now()) @map("created_at")
  updatedAt                DateTime             @updatedAt @map("updated_at")
  ownedBusinesses          Business[]           @relation("BusinessOwner")
  businessUsers            BusinessUser[]
  auditLogs                AuditLog[]
  actorLoyaltyTransactions LoyaltyTransaction[] @relation("LoyaltyTransactionActor")

  @@map("users")
}

model Business {
  id                  String               @id @default(cuid())
  ownerId             String               @map("owner_id")
  name                String
  slug                String               @unique
  type                String
  logoUrl             String?              @map("logo_url")
  coverUrl            String?              @map("cover_url")
  currency            String               @default("IQD")
  language            String               @default("ar")
  city                String?
  status              BusinessStatus       @default(ACTIVE)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  owner               User                 @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  businessUsers       BusinessUser[]
  menuCategories      MenuCategory[]
  menuItems           MenuItem[]
  loyaltyPrograms     LoyaltyProgram[]
  loyaltyMemberships  LoyaltyMembership[]
  loyaltyTransactions LoyaltyTransaction[]
  walletPasses        WalletPass[]
  subscriptions       Subscription[]
  auditLogs           AuditLog[]

  @@index([ownerId])
  @@map("businesses")
}

model BusinessUser {
  id         String             @id @default(cuid())
  businessId String             @map("business_id")
  userId     String             @map("user_id")
  role       BusinessUserRole
  status     BusinessUserStatus @default(ACTIVE)
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
  @@map("business_users")
}

model MenuCategory {
  id         String     @id @default(cuid())
  businessId String     @map("business_id")
  nameAr     String     @map("name_ar")
  nameEn     String?    @map("name_en")
  sortOrder  Int        @default(0) @map("sort_order")
  isActive   Boolean    @default(true) @map("is_active")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items      MenuItem[]

  @@index([businessId])
  @@map("menu_categories")
}

model MenuItem {
  id            String       @id @default(cuid())
  businessId    String       @map("business_id")
  categoryId    String       @map("category_id")
  nameAr        String       @map("name_ar")
  nameEn        String?      @map("name_en")
  descriptionAr String?      @map("description_ar")
  descriptionEn String?      @map("description_en")
  price         Decimal      @db.Decimal(10, 2)
  imageUrl      String?      @map("image_url")
  isAvailable   Boolean      @default(true) @map("is_available")
  sortOrder     Int          @default(0) @map("sort_order")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category      MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([categoryId])
  @@map("menu_items")
}

model Plan {
  id                   String         @id @default(cuid())
  name                 String         @unique
  stripeMonthlyPriceId String?        @map("stripe_monthly_price_id")
  stripeYearlyPriceId  String?        @map("stripe_yearly_price_id")
  limitsJson           Json           @map("limits_json")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  subscriptions        Subscription[]

  @@map("plans")
}

model Subscription {
  id                   String             @id @default(cuid())
  businessId           String             @map("business_id")
  planId               String             @map("plan_id")
  stripeCustomerId     String?            @map("stripe_customer_id")
  stripeSubscriptionId String?            @map("stripe_subscription_id")
  status               SubscriptionStatus @default(INACTIVE)
  currentPeriodEnd     DateTime?          @map("current_period_end")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  business             Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan                 Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([planId])
  @@map("subscriptions")
}

model AuditLog {
  id           String    @id @default(cuid())
  businessId   String?   @map("business_id")
  userId       String?   @map("user_id")
  action       String
  metadataJson Json?     @map("metadata_json")
  createdAt    DateTime  @default(now()) @map("created_at")
  business     Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([userId])
  @@map("audit_logs")
}

model LoyaltyProgram {
  id                  String               @id @default(cuid())
  businessId          String               @map("business_id")
  name                String
  description         String?
  stampGoal           Int                  @map("stamp_goal")
  rewardName          String               @map("reward_name")
  rewardDescription   String?              @map("reward_description")
  isActive            Boolean              @default(true) @map("is_active")
  cardColor           String?              @map("card_color")
  accentColor         String?              @map("accent_color")
  logoUrl             String?              @map("logo_url")
  terms               String?
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  business            Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  memberships         LoyaltyMembership[]
  transactions        LoyaltyTransaction[]
  stampStyle          LoyaltyStampStyle?

  @@index([businessId])
  @@map("loyalty_programs")
}

model LoyaltyStampStyle {
  id                    String                    @id @default(cuid())
  loyaltyProgramId      String                    @unique @map("loyalty_program_id")
  styleType             LoyaltyStampStyleType     @default(PRESET) @map("style_type")
  presetKey             LoyaltyStampPresetKey     @default(STAR) @map("preset_key")
  backgroundColor       String                    @map("background_color")
  accentColor           String                    @map("accent_color")
  textColor             String                    @map("text_color")
  walletBackgroundColor String                    @default("#2563eb") @map("wallet_background_color")
  imageBackgroundColor  String                    @default("#7c2d12") @map("image_background_color")
  imageSurfaceColor     String                    @default("#92400e") @map("image_surface_color")
  imageAccentColor      String                    @default("#facc15") @map("image_accent_color")
  imageTextColor        String                    @default("#ffffff") @map("image_text_color")
  stampFilledColor      String                    @default("#facc15") @map("stamp_filled_color")
  stampEmptyColor       String                    @default("#d6d3d1") @map("stamp_empty_color")
  rewardBannerColor     String                    @default("#a16207") @map("reward_banner_color")
  themePreset           LoyaltyWalletThemePreset  @default(DEFAULT) @map("theme_preset")
  colorMode             LoyaltyWalletColorMode    @default(PRESET) @map("color_mode")
  layoutVariant         LoyaltyStampLayoutVariant @default(MODERN) @map("layout_variant")
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")
  loyaltyProgram        LoyaltyProgram            @relation(fields: [loyaltyProgramId], references: [id], onDelete: Cascade)

  @@map("loyalty_stamp_styles")
}

model Customer {
  id                  String               @id @default(cuid())
  phone               String?              @unique
  email               String?              @unique
  name                String?
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  loyaltyMemberships  LoyaltyMembership[]
  loyaltyTransactions LoyaltyTransaction[]

  @@map("customers")
}

model LoyaltyMembership {
  id                    String                  @id @default(cuid())
  businessId            String                  @map("business_id")
  loyaltyProgramId      String                  @map("loyalty_program_id")
  customerId            String                  @map("customer_id")
  stampCount            Int                     @default(0) @map("stamp_count")
  rewardReady           Boolean                 @default(false) @map("reward_ready")
  totalStampsEarned     Int                     @default(0) @map("total_stamps_earned")
  totalRewardsRedeemed  Int                     @default(0) @map("total_rewards_redeemed")
  publicAccessTokenHash String?                 @unique @map("public_access_token_hash")
  publicAccessTokenIssuedAt DateTime?           @map("public_access_token_issued_at")
  publicAccessTokenLastViewedAt DateTime?       @map("public_access_token_last_viewed_at")
  status                LoyaltyMembershipStatus @default(ACTIVE)
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")
  business              Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  loyaltyProgram        LoyaltyProgram          @relation(fields: [loyaltyProgramId], references: [id], onDelete: Cascade)
  customer              Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions          LoyaltyTransaction[]
  walletPasses          WalletPass[]

  @@unique([customerId, loyaltyProgramId])
  @@index([businessId])
  @@index([loyaltyProgramId])
  @@index([customerId])
  @@map("loyalty_memberships")
}

model WalletPass {
  id                String             @id @default(cuid())
  businessId        String             @map("business_id")
  membershipId      String             @map("membership_id")
  platform          WalletPassPlatform
  googleClassId     String?            @map("google_class_id")
  googleObjectId    String?            @map("google_object_id")
  saveUrl           String?            @map("save_url")
  heroImageUrl      String?            @map("hero_image_url")
  scanTokenHash     String?            @unique @map("scan_token_hash")
  scanTokenVersion  Int?               @map("scan_token_version")
  scanTokenIssuedAt DateTime?          @map("scan_token_issued_at")
  scanTokenLast4    String?            @map("scan_token_last4")
  status            WalletPassStatus   @default(PENDING)
  lastSyncedAt      DateTime?          @map("last_synced_at")
  syncError         String?            @map("sync_error")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  business          Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  membership        LoyaltyMembership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, platform])
  @@index([businessId])
  @@index([membershipId])
  @@map("wallet_passes")
}

model LoyaltyTransaction {
  id                String                 @id @default(cuid())
  businessId        String                 @map("business_id")
  loyaltyProgramId  String                 @map("loyalty_program_id")
  membershipId      String                 @map("membership_id")
  customerId        String                 @map("customer_id")
  actorUserId       String?                @map("actor_user_id")
  type              LoyaltyTransactionType
  stampsDelta       Int                    @map("stamps_delta")
  reason            String?
  createdAt         DateTime               @default(now()) @map("created_at")
  business          Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  loyaltyProgram    LoyaltyProgram         @relation(fields: [loyaltyProgramId], references: [id], onDelete: Cascade)
  membership        LoyaltyMembership      @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  customer          Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  actorUser         User?                  @relation("LoyaltyTransactionActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([loyaltyProgramId])
  @@index([membershipId])
  @@index([customerId])
  @@index([actorUserId])
  @@map("loyalty_transactions")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum BusinessUserRole {
  OWNER
  MANAGER
  STAFF
}

enum BusinessUserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum SubscriptionStatus {
  INACTIVE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum LoyaltyMembershipStatus {
  ACTIVE
  INACTIVE
}

enum WalletPassPlatform {
  GOOGLE_WALLET
}

enum WalletPassStatus {
  PENDING
  ACTIVE
  ERROR
}

enum LoyaltyStampStyleType {
  PRESET
}

enum LoyaltyStampPresetKey {
  STAR
  COOKIE
  COFFEE
  BOWL
  BURGER
  PIZZA
  HEART
  CUPCAKE
}

enum LoyaltyStampLayoutVariant {
  MODERN
  COMPACT
}

enum LoyaltyWalletThemePreset {
  DEFAULT
  COFFEE
  RESTAURANT
  DESSERT
  MINIMAL
  CUSTOM
}

enum LoyaltyWalletColorMode {
  PRESET
  CUSTOM
}

enum LoyaltyTransactionType {
  STAMP_ADDED
  REWARD_REDEEMED
  ADJUSTMENT
  VOID
}
