DATABASE_URL=
REDIS_URL=
# Real Clerk JWT verification requires CLERK_JWT_ISSUER outside development.
# CLERK_JWKS_URL is optional; when omitted the API uses <issuer>/.well-known/jwks.json.
# CLERK_SECRET_KEY is not required unless a future sprint adds Clerk Admin API calls.
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER=
CLERK_JWKS_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
API_PORT=3000
NODE_ENV=development
CUSTOMER_WEB_BASE_URL=http://localhost:3001
GOOGLE_WALLET_ENABLED=false
GOOGLE_WALLET_ISSUER_ID=3388000000023161301
GOOGLE_WALLET_CREDENTIALS_PATH=
GOOGLE_WALLET_ORIGINS=http://localhost:3001
# WALLET_IMAGE_PUBLIC_BASE_URL — public HTTPS URL where Google fetches generated pass images.
# In production: set to a stable CDN/storage URL (e.g. https://api.waflo.app/generated).
# In local smoke tests: set to the current localhost.run tunnel URL.
#   IMPORTANT: this URL changes on every tunnel restart. Update .env AND restart the API.
#   Never commit a tunnel URL (*.lhr.life) to version control or paste it in reports.
WALLET_IMAGE_PUBLIC_BASE_URL=https://api.waflo.app/generated
WALLET_SCAN_TOKEN_SECRET=

# Apple Wallet is backend-owned and opt-in. Keep certificate files outside this repository.
APPLE_WALLET_ENABLED=false
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_PASS_TYPE_IDENTIFIER=
APPLE_WALLET_ORGANIZATION_NAME=Waflo
APPLE_WALLET_CERTIFICATE_PATH=
APPLE_WALLET_CERTIFICATE_PASSWORD=
APPLE_WALLET_WWDR_CERTIFICATE_PATH=
APPLE_WALLET_WEB_SERVICE_ENABLED=false
# Apple Wallet appends /v1 to this base. Example: https://api.example.test/apple-wallet
APPLE_WALLET_WEB_SERVICE_BASE_URL=
APPLE_WALLET_UPDATE_AUTH_TOKEN_SECRET=
APPLE_WALLET_APNS_ENABLED=false
APPLE_WALLET_APNS_ENVIRONMENT=sandbox
APPLE_WALLET_APNS_TIMEOUT_MS=10000
