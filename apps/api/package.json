{
  "name": "tavrix-menu-api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS API foundation for Tavrix Menu.",
  "scripts": {
    "predev": "prisma generate",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "prebuild": "prisma generate",
    "build": "nest build",
    "prelint": "prisma generate",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "preprisma:seed": "prisma generate",
    "prisma:seed": "ts-node prisma/seed.ts",
    "preseed:dev": "prisma generate",
    "seed:dev": "ts-node prisma/seed.ts",
    "verify:loyalty-concurrency": "ts-node scripts/verify-loyalty-concurrency.ts",
    "test": "node --test -r ts-node/register ./src/env.validation.spec.ts ./src/modules/apple-wallet/apple-wallet.service.spec.ts ./src/modules/apple-wallet/apple-wallet-apns.client.spec.ts ./src/modules/apple-wallet/apple-wallet-push-job.service.spec.ts ./src/modules/apple-wallet/apple-wallet-update.service.spec.ts ./src/modules/apple-wallet/public-apple-wallet-pass.service.spec.ts ./src/modules/google-wallet/google-wallet.service.spec.ts ./src/modules/google-wallet/wallet-pass.service.spec.ts ./src/modules/google-wallet/wallet-refresh-job.service.spec.ts ./src/modules/google-wallet/wallet-scan.service.spec.ts ./src/modules/loyalty/loyalty-stamp-style.service.spec.ts ./src/modules/loyalty/loyalty.service.spec.ts ./src/modules/loyalty/stamp-image-renderer.service.spec.ts",
    "wallet:smoke-test": "ts-node scripts/wallet-smoke-test.ts",
    "apple-wallet:smoke-test": "ts-node scripts/apple-wallet-smoke-test.ts",
    "apple-wallet:inspect-pass": "ts-node scripts/apple-wallet-inspect-pass.ts",
    "apple-wallet:update-diagnostics": "ts-node scripts/apple-wallet-update-diagnostics.ts",
    "wallet:render-stamp-preview": "ts-node scripts/render-stamp-preview.ts",
    "test:wallet": "node --test -r ts-node/register ./src/env.validation.spec.ts ./src/modules/apple-wallet/apple-wallet.service.spec.ts ./src/modules/apple-wallet/apple-wallet-apns.client.spec.ts ./src/modules/apple-wallet/apple-wallet-push-job.service.spec.ts ./src/modules/apple-wallet/apple-wallet-update.service.spec.ts ./src/modules/apple-wallet/public-apple-wallet-pass.service.spec.ts ./src/modules/google-wallet/google-wallet.service.spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^6.9.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "google-auth-library": "^10.7.0",
    "node-forge": "^1.4.0",
    "passkit-generator": "^3.5.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.3",
    "@types/node": "^24.0.3",
    "@types/node-forge": "^1.3.14",
    "prisma": "^6.9.0",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
